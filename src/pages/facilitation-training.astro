---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProgramSection from '../components/ProgramSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { facilitationPage as c } from '../data/pages';
---

<BaseLayout title={c.seo.title} description={c.seo.description}>
  <PageHero title={c.hero.title} lead={c.hero.lead} body={c.hero.body} figure={c.hero.figure} />

  <ProgramSection
    id={c.practise.id}
    title={c.practise.title}
    list={c.practise.list}
    takeaway={c.practise.takeaway}
    focus={c.practise.focus}
    format={c.practise.format}
    tone="white"
  />

  <CtaBand cta={c.cta} />
</BaseLayout>
