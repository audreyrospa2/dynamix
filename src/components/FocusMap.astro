---
// The copy document's "Foundations → Development Experience → Applied
// Capabilities → intended Business Outcomes" map, shown as four linked cells.
interface Props {
  focus: [string, string, string, string];
  heading?: string;
}
const { focus, heading = 'Learning focus' } = Astro.props;
const labels = ['Foundations', 'Development Experience', 'Applied Capabilities', 'Intended Business Outcomes'];
---

<div class="focus">
  <p class="focus__heading">{heading}</p>
  <ol class="focus__path">
    {
      focus.map((t, i) => (
        <li class="focus__cell">
          <span class="focus__label">{labels[i]}</span>
          <span class="focus__text">{t}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .focus { margin-top: 1.75rem; }
  .focus__heading { font-size: var(--step--1); font-weight: 700; margin-bottom: 0.6rem; }
  .focus__path { display: grid; gap: 0; border-top: 3px solid var(--yellow); }
  .focus__cell {
    position: relative; display: grid; gap: 0.15rem; padding: 0.7rem 0 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  .focus__label { font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.65; }
  .focus__text { font-size: var(--step--1); line-height: 1.4; }
  .focus__cell:last-child .focus__text { font-weight: 650; }
  @media (min-width: 52rem) {
    .focus__path { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; border-top: 0; }
    .focus__cell { border-top: 3px solid var(--yellow); border-bottom: 0; padding: 0.75rem 0 0; }
    .focus__cell:not(:last-child)::after { content: '→'; position: absolute; right: -1.05rem; top: 0.55rem; font-weight: 700; }
  }
</style>
