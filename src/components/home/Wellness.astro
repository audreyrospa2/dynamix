---
import { wellness as c } from '../../data/home';
---

<section class="section on-yellow" id="wellness" aria-labelledby="well-title">
  <div class="wrap split">
    <div class="split__media well__media">
      <img src={c.image.src} width={c.image.w} height={c.image.h} alt={c.image.alt} loading="lazy" />
    </div>
    <div class="split__text">
      <h2 id="well-title" class="h2">{c.title}</h2>
      <div class="prose">
        {c.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="well__cta">
        <a class="btn btn--ink" href={c.cta.href}>{c.cta.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .well__media img { aspect-ratio: 4 / 3; }
  .well__cta { margin-top: 2.25rem; }
  .on-yellow .btn--ink:hover { background: var(--white); color: var(--ink); }
</style>
