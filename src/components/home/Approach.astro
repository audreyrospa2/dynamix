---
import { approach as c } from '../../data/home';
---

<section class="section on-paper" aria-labelledby="appr-title">
  <div class="wrap">
    <h2 id="appr-title" class="h2 appr__title">{c.title}</h2>
    <ol class="appr__steps">
      {
        c.steps.map((s, i) => (
          <li class="appr__step">
            <span class="appr__num" aria-hidden="true">{i + 1}</span>
            <h3 class="appr__step-title">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <a class="link" href={c.cta.href}>{c.cta.label}</a>
  </div>
</section>

<style>
  .appr__title { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .appr__steps { display: grid; gap: 2.5rem; margin-bottom: 3rem; counter-reset: s; }
  .appr__step { position: relative; padding-left: 6.25rem; min-height: 5rem; }
  .appr__num {
    position: absolute; left: 0; top: 0; width: 5rem; height: 5rem; border-radius: 50%; background: var(--yellow);
    display: grid; place-items: center; font-size: var(--step-3); font-weight: 800; line-height: 1;
  }
  .appr__step-title { font-size: var(--step-1); font-weight: 750; letter-spacing: -0.015em; line-height: 1.2; margin-bottom: 0.4rem; padding-top: 0.5rem; }
  .appr__step p { max-width: 30ch; color: var(--mute); }
  .appr__step:not(:last-child)::after { content: ''; position: absolute; left: 2.5rem; top: 5.25rem; bottom: -2.25rem; border-left: 2px dashed var(--ink); }
  @media (min-width: 52rem) {
    .appr__steps { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .appr__step { padding: 6.5rem 0 0; }
    .appr__step-title { padding-top: 0; }
    .appr__step:not(:last-child)::after { left: 5.5rem; right: -1.5rem; top: 2.5rem; bottom: auto; border-left: 0; border-top: 2px dashed var(--ink); }
  }
</style>
