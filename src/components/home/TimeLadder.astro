---
import { timeLadder as c } from '../../data/home';
---

<section class="section on-white" aria-labelledby="ladder-title">
  <div class="wrap">
    <h2 id="ladder-title" class="h2 h2--wide ladder__title">{c.title}</h2>
    <ol class="ladder">
      {
        c.steps.map((s, i) => (
          <li class="ladder__row" style={`--w:${(i + 1) * 25}%; --tint:${(i + 1) * 25}%`}>
            <div class="ladder__bar" data-ladder-bar>
              <span class="ladder__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="ladder__step-title">{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ladder__title { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .ladder { display: grid; gap: 0.75rem; }
  .ladder__bar {
    display: flex; gap: 1.25rem; align-items: center; padding: 1.25rem 1.5rem; border-radius: 99px 0 0 99px;
    background: color-mix(in srgb, var(--yellow) var(--tint), var(--white));
  }
  .ladder__num { flex: none; width: 3rem; height: 3rem; border-radius: 50%; background: var(--ink); color: var(--white); display: grid; place-items: center; font-weight: 800; }
  .ladder__step-title { font-size: var(--step-1); font-weight: 750; letter-spacing: -0.015em; line-height: 1.15; }
  .ladder__bar p { font-size: var(--step--1); margin-top: 0.15rem; max-width: 46ch; }
  @media (min-width: 52rem) {
    .ladder__bar { width: max(var(--w), 22rem); }
  }
  @media (max-width: 51.99rem) {
    .ladder__bar { border-radius: 2rem 0 0 2rem; margin-left: calc(4% * (4 - var(--n, 4))); }
    .ladder__row:nth-child(1) .ladder__bar { margin-right: 18%; }
    .ladder__row:nth-child(2) .ladder__bar { margin-right: 12%; }
    .ladder__row:nth-child(3) .ladder__bar { margin-right: 6%; }
  }
</style>
