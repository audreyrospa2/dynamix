---
import { contact, footerNav, routes } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer on-ink">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href={routes.home} aria-label="Dynamix Plus home">
        <img src="/images/logo-dynamix-plus.webp" width="900" height="281" alt="Dynamix Plus Human Intelligence" loading="lazy" />
      </a>
    </div>

    <div class="site-footer__contact">
      <h2 class="site-footer__title">{contact.brand} enquiries</h2>
      <p class="site-footer__person">{contact.person}</p>
      <dl class="site-footer__list">
        <div><dt>WhatsApp</dt><dd><a href={contact.whatsappUrl}>{contact.whatsapp}</a></dd></div>
        <div><dt>Phone</dt><dd><a href={contact.phoneUrl}>{contact.phone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={contact.emailUrl}>{contact.email}</a></dd></div>
      </dl>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {footerNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="wrap">
    <p class="site-footer__legal">© {year} {contact.legal} · {contact.brand}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink-deep); padding-top: clamp(3.5rem, 7vw, 6rem); }
  .site-footer__grid { display: grid; gap: 2.5rem; }
  .site-footer__brand img { width: clamp(11rem, 20vw, 15rem); height: auto; }
  .site-footer__title { font-size: var(--step-1); font-weight: 700; margin-bottom: 0.25rem; }
  .site-footer__person { color: var(--mute-on-ink); margin-bottom: 1rem; }
  .site-footer__list { display: grid; gap: 0.5rem; }
  .site-footer__list div { display: flex; gap: 1rem; }
  .site-footer__list dt { width: 5.5rem; color: var(--mute-on-ink); }
  .site-footer__list dd { margin: 0; }
  .site-footer a { text-decoration: none; background: linear-gradient(var(--yellow), var(--yellow)) 0 100% / 0 2px no-repeat; transition: background-size 0.18s; }
  .site-footer a:hover { background-size: 100% 2px; }
  .site-footer__brand a, .site-footer__brand a:hover { background: none; }
  .site-footer__nav ul { display: grid; gap: 0.5rem; }
  .site-footer__legal { margin-top: clamp(3rem, 6vw, 5rem); padding-block: 1.5rem; border-top: 1px solid var(--line-on-ink); color: var(--mute-on-ink); font-size: var(--step--1); }
  @media (min-width: 52rem) {
    .site-footer__grid { grid-template-columns: 1.1fr 1.4fr 0.8fr; align-items: start; }
  }
</style>
