---
import { framework as home } from '../../data/home';

type Item = string | { label: string; text?: string };
interface Stage { title: string; note?: string; items: Item[] }
interface Props {
  cta?: boolean;
  title?: string;
  intro?: string;
  lead?: string;
  stages?: Stage[];
  footnote?: string;
}
const { cta = true, title = home.title, intro = home.intro, lead = home.lead, stages = home.stages, footnote = home.footnote } = Astro.props;
const label = (i: Item) => (typeof i === 'string' ? i : i.label);
const text = (i: Item) => (typeof i === 'string' ? '' : i.text ?? '');
---

<section class="section on-ink" id="framework" aria-labelledby="fw-title">
  <div class="wrap">
    <h2 id="fw-title" class="h2 h2--wide fw__title">{title}</h2>
    {
      (intro || lead) && (
        <div class="fw__intro prose">
          {intro && <p>{intro}</p>}
          {lead && <p class="fw__lead">{lead}</p>}
        </div>
      )
    }
    <ol class="fw__stages">
      {
        stages.map((s, i) => (
          <li class:list={['fw__stage', { 'fw__stage--last': i === stages.length - 1 }]} style={`--i:${i}`}>
            <span class="fw__num" aria-hidden="true">{i + 1}</span>
            <h3 class="fw__stage-title">{s.title}</h3>
            {s.note && <p class="fw__note">{s.note}</p>}
            <ul class="fw__items">
              {
                s.items.map((it) => (
                  <li>
                    <span class="fw__label">{label(it)}</span>
                    {text(it) && <span class="fw__text">{text(it)}</span>}
                  </li>
                ))
              }
            </ul>
          </li>
        ))
      }
    </ol>
    {footnote && <p class="fw__footnote">{footnote}</p>}
    {cta && <a class="btn btn--yellow fw__cta" href={home.cta.href}>{home.cta.label}</a>}
  </div>
</section>

<style>
  .fw__title { margin-bottom: 1.75rem; }
  .fw__intro { margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 62ch; }
  .fw__lead { font-weight: 700; }
  .fw__stages { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  .fw__stage { border: 1.5px solid var(--line-on-ink); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .fw__stage--last { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }
  .fw__num {
    width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; font-weight: 800;
    background: var(--yellow); color: var(--ink);
  }
  .fw__stage--last .fw__num { background: var(--ink); color: var(--yellow); }
  .fw__stage-title { font-size: var(--step-1); font-weight: 750; letter-spacing: -0.015em; line-height: 1.15; }
  .fw__note { font-size: var(--step--1); color: var(--mute-on-ink); }
  .fw__stage--last .fw__note { color: var(--ink); }
  .fw__items li { padding-block: 0.45rem; border-top: 1px solid var(--line-on-ink); font-size: var(--step--1); display: grid; gap: 0.15rem; }
  .fw__label { font-weight: 600; }
  .fw__text { color: var(--mute-on-ink); }
  .fw__stage--last .fw__items li { border-color: rgba(48, 48, 51, 0.28); }
  .fw__stage--last .fw__text { color: var(--ink); }
  .fw__footnote { margin-bottom: 2rem; max-width: 62ch; color: var(--mute-on-ink); font-size: var(--step--1); }
  @media (min-width: 62rem) {
    /* A rising staircase: each stage starts higher than the one before it. */
    .fw__stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: end; }
    .fw__stage { margin-top: calc((3 - var(--i)) * 3.25rem); min-height: 22rem; padding: 1.75rem; }
    .fw__items { margin-top: auto; }
  }
</style>
